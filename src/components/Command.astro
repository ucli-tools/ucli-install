---
// The install bar (bar, 5.2) or a code block with a Copy button (5.3). `cmd` or `lines` is the single
// source: the visible text and the copied text are the same element. A line is { t, c?: true } or a
// plain string; comment lines are shown and copied as they are. The "$ " is generated content.
export interface Line { t: string; c?: boolean }
interface Props {
  lines?: (Line | string)[];
  cmd?: string;
  label?: string;
  bar?: boolean;
  note?: string;
}
const { lines, cmd, label, bar = false } = Astro.props;
const all: Line[] = (lines ?? (cmd ? [cmd] : [])).map((l) => (typeof l === 'string' ? { t: l } : l));
const text = all.map((l) => l.t).join('\n');
let h = 0;
for (const ch of text + (label ?? '')) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const id = 'cmd-' + h.toString(36);
---

{bar ? (
  <div class="u-install">
    {label && <p class="u-install__label">{label}</p>}
    <div class="u-cmd"><pre class="u-cmd__body" id={id}>{text}</pre>
      <button type="button" class="u-copy" data-copy={id} aria-label="Copy command" hidden>Copy</button></div>
    <slot />
  </div>
) : (
  <div class="u-code"><div class="u-code__x" data-scroll-x tabindex="0" role="region" aria-label={label ?? 'Command'}><pre id={id}>{all.map((l, i) => (
    <Fragment><span class={l.c ? 'u-cm' : 'u-pl'}>{l.t}</span>{i < all.length - 1 ? '\n' : ''}</Fragment>
  ))}</pre></div>
    <button type="button" class="u-copy u-copy--s" data-copy={id} aria-label={`Copy ${label ?? 'command'}`} hidden>Copy</button></div>
)}
