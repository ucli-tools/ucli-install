---
// Left-aligned masthead (design 5.2). `interior` gives the smaller page head used by /tools and
// /community. The h1 text goes in the default slot, so a line break stays where the copy had it.
interface Props {
  kicker?: string;
  lead?: string;
  interior?: boolean;
}
const { kicker, lead, interior = false } = Astro.props;
---

<div class="u-wrap">
  <section class={interior ? 'pagehead' : 'u-masthead'}>
    <div class="u-masthead__main">
      {kicker && <p class="u-kicker">{kicker}</p>}
      <h1 class:list={[{ 'u-masthead__title': !interior }]}><slot /></h1>
      {lead && <p class="u-lead">{lead}</p>}
      <slot name="meta" />
      <slot name="command" />
      <div class="u-masthead__actions"><slot name="actions" /></div>
    </div>
    <slot name="contents" />
  </section>
</div>

<style>
  h1.u-masthead__title { max-width: 22ch; }
  .pagehead { padding-block: var(--u-space-8) var(--u-space-6); }
  .pagehead h1 { margin-bottom: var(--u-space-4); }
  @media (min-width: 1024px) { .pagehead { padding-block: var(--u-space-9) var(--u-space-7); } }
</style>
