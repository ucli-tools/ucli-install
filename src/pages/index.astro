---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import Command from '../components/Command.astro';
import { INSTALL_CMD, INSTALL_URL, GET_STARTED_URL } from '../data/commands';
---

<Layout title="Install UCLI Tools" description="Install the UCLI tool manager with one command">
  <Masthead lead="Professional CLI tools for developers">
    <Fragment>Install UCLI Tools</Fragment>
    <Fragment slot="command">
      <Command label="Install ucli" lines={[INSTALL_CMD]} />
      <p class="u-quiet"><a class="u-link" href={INSTALL_URL}>Read the script</a></p>
    </Fragment>
    <Fragment slot="actions">
      <a class="u-link" href="https://ucli.tools">Home</a>
      <a class="u-link" href="https://docs.ucli.tools">Docs</a>
      <a class="u-link" href={GET_STARTED_URL}>Quick Start</a>
      <a class="u-link" href="https://github.com/ucli-tools">GitHub</a>
    </Fragment>
  </Masthead>
</Layout>
